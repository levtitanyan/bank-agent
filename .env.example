# Gemini (AI Studio key)
GOOGLE_API_KEY=your_key_here
GOOGLE_GENAI_USE_VERTEXAI=FALSE
TARIFF_GEMINI_MODEL=gemini-3.5-flash-lite

# Logging
TARIFF_LOG_LEVEL=INFO
# HTTP layer (optional - defaults live in config.py HttpSettings)
# Contact address advertised in the User-Agent, so the bank can identify our traffic.
TARIFF_HTTP__USER_AGENT_CONTACT=
# TARIFF_HTTP__READ_TIMEOUT=60
# TARIFF_HTTP__OFFLINE=false
# TARIFF_HTTP__MIN_REQUEST_INTERVAL_S=1.0
